{
  "name": "dsh-har-triage",
  "version": "0.1.1",
  "description": "Offline HAR diagnostics with minimal evidence for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/po-et/dsh-har-triage.git" },
  "homepage": "https://github.com/po-et/dsh-har-triage#readme",
  "bugs": { "url": "https://github.com/po-et/dsh-har-triage/issues" },
  "engines": { "node": ">=24.9.0" },
  "main": "./src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./core": "./src/analyze.js", "./report": "./src/report.js" },
  "bin": { "har-triage": "./src/cli.js" },
  "files": ["src/", "cordis.patch.yml", "docs/report-demo.jpg", "README.md", "SECURITY.md", "LICENSE"],
  "keywords": ["dsh-plugin", "har", "devtools", "diagnostics", "privacy", "network"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js",
    "smoke:host": "node --expose-internals scripts/host-smoke.js",
    "smoke:profile": "node scripts/profile-smoke.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2 || 0.2.1-alpha.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2 || 0.2.1-alpha.2 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "yaml": "2.9.1"
  }
}
